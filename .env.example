# Pasta de inputs (KV, MIV, facas). Pode apontar para a pasta sincronizada do Google Drive.
DESDOBRADOR_INPUTS=./inputs
# Perfis ICC (não versionados por licença)
ICC_SRGB=/Library/ColorSync/Profiles/sRGB Profile.icc
ICC_FOGRA39=/Library/Application Support/Adobe/Color/Profiles/Recommended/CoatedFOGRA39.icc
# M6 — Google Slides/Drive (OAuth ou service account)
GOOGLE_APPLICATION_CREDENTIALS=
# Opcional — revisão visual por modelo de visão (validador item 8)
ANTHROPIC_API_KEY=
